# Demo account passwords for scripts/seed-demo.sh.
# Copy this file to ".env", replace the placeholder values, and load it
# before running the seed script:   set -a; . ./.env; set +a
# ".env" is gitignored — never commit real values.
# In GitHub Codespaces these are provided by Codespaces user secrets
# with the same names, so no .env file is needed there.
OMS_DEMO_PASSWORD=changeme
OMS_PRIYA_PASSWORD=changeme
OMS_SELLER_PASSWORD=changeme
OMS_SELLER2_PASSWORD=changeme
OMS_SELLER3_PASSWORD=changeme
OMS_ADMIN_PASSWORD=changeme
